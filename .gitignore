# 生成物はディレクトリ単位で無視する。拡張子では無視しない —
# ルートに落ちたら git status に出てほしいため。以前は *.bin を無視して
# いて、そのせいでルートに重み 33 個が溜まっても誰も気づかなかった。
#
# weights/ — 学習済みの重み (11 GB)。中身の説明は weights/WEIGHTS.md
#            (これも追跡しない。git に存在しないファイルの説明だから)
# logs/    — 学習曲線の csv と実行ログ
/weights/
/logs/
# アカウントごとに `.ggs_credentials.<名前>` を置くので、末尾まで含めて弾く。
# 完全一致にしていたせいで 2 つめのアカウントのぶんが素通りし、公開リポジトリへ
# push してしまった (パスワードを変えて履歴を書き換えた)。
.ggs_credentials*
# GGS の対局ログ・棋譜・分析の出力。実験の副産物で、読む人には要らない。
# CSS を 16 行直したコミットに 13,591 行が紛れ込んでいた (cc97a0b)。
/ggs_games/
# 引き継ぎメモ。git には入れない取り決めなのに、同じコミットで入っていた。
/HANDOFF.md
/gui/target/
/gui/gen/
node_modules/
# フロント (Vite) のビルド出力。index.html も含めて生成物なので追跡しない。
# Tauri は frontendDist として ui/ を読むため、アプリを組む前に
# `npm ci && npm run build` が要る (CI もその順で回している)。
/gui/ui/
__pycache__/
# 作業中の覚え書き。**追跡しない** — 手が動くたびに書き換わるメモで、
# 履歴に残す値打ちが無い (一度入れてしまい、遡って落とした)。
/notes/
