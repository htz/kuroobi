/target
/train_data
# Ignore generated output by directory, never by extension — anything that
# lands at the root should show up in git status. *.bin used to be ignored,
# which is why 33 weight files piled up at the root unnoticed.
#
# weights/ — trained weights (11 GB). Described in weights/WEIGHTS.md
#            (untracked as well, since it describes files git does not have)
# logs/    — training-curve csv and run logs
/weights/
/logs/
# Credentials are stored per account as `.ggs_credentials.<name>`, so match
# the suffix too. An exact-match rule once let a second account's file through
# and it was pushed to the public repo (password rotated, history rewritten).
.ggs_credentials*
/gui/target/
/gui/gen/
node_modules/
# Frontend (Vite) build output. Generated, index.html included, so untracked.
# Tauri reads ui/ as frontendDist, so `npm ci && npm run build` must run
# before building the app (CI uses that order too).
/gui/ui/
__pycache__/
# Working notes. **Untracked** — they change with every edit and are not worth
# keeping in history (they were committed once and removed retroactively).
/notes/
/tmp/
