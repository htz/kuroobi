{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuroobi",
  "version": "0.1.0",
  "identifier": "dev.htz.kuroobi",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kuroobi",
        "width": 1100,
        "height": 820,
        "minWidth": 900,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}