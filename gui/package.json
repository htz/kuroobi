{
  "name": "kuroobi-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "test -z \"$(ls src-ui/js/*.js 2>/dev/null)\" && tsc --noEmit && eslint src-ui || (echo 'stale .js files in src-ui/js (left from the TypeScript port); Vite prefers them, so delete them' && exit 1)",
    "lint": "eslint src-ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
