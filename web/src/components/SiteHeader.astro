---
import { href, LANGS, t, type Lang } from '../i18n';
import Logo from './Logo.astro';

export type Section = 'top' | 'web' | 'notes';
interface Props {
  lang: Lang;
  active: Section;
  /** This page's path without the language prefix, so the language menu lands on the same page. */
  path: string;
}
const { lang, active, path } = Astro.props;
const items = [
  { id: 'app', label: t(lang, 'site.app'), href: href(lang, '/') + '#app', phone: false },
  { id: 'web', label: 'Kuroobi for web', href: href(lang, '/play/'), phone: true },
  { id: 'notes', label: t(lang, 'site.notes'), href: href(lang, '/notes/'), phone: true },
];
// Language names stay in their own language, so a reader who cannot read the page still finds theirs.
const langNames: Record<Lang, string> = { ja: '日本語', en: 'English' };
const themes = ['auto', 'light', 'dark'] as const;
---

<header class="hd" lang={lang}>
  <div class="w-wrap hd-row">
    <a href={href(lang, '/')} aria-label={t(lang, 'site.home')} class="w-plain hd-logo"><Logo /></a>
    <nav aria-label={t(lang, 'site.nav')} class="hd-nav">
      {
        items.map((it) => (
          <a
            href={it.href}
            class:list={['w-nav', 'hd-item', { 'w-hide-phone': !it.phone }]}
            aria-current={it.id === active ? 'page' : undefined}
          >
            {it.label}
          </a>
        ))
      }
    </nav>
    <div class="hd-tools">
      <a href="https://github.com/htz/kuroobi" class="w-plain w-btn hd-icon hd-ext w-hide-phone" target="_blank" rel="noopener" aria-label={`${t(lang, 'site.github')} (${t(lang, 'site.newWindow')})`}>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
        <svg class="hd-ext-mark" aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"></path><path d="M20 4l-9 9"></path></svg>
      </a>

      <div class="hd-menu" data-menu>
        <button type="button" class="w-btn hd-lang" aria-label={t(lang, 'site.langLabel')} aria-haspopup="true" aria-expanded="false">
          <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path></svg>
          <span class="w-hide-phone">{t(lang, 'site.langShort')}</span>
        </button>
        <div role="group" aria-label={t(lang, 'site.langLabel')} class="hd-pop" hidden>
          {
            LANGS.map((l) => (
              <a href={href(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} class="w-plain w-btn hd-choice">
                <span>{langNames[l]}</span>
                <span aria-hidden="true" class="hd-mark">{l === lang ? '✓' : ''}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="hd-menu" data-menu data-theme-menu>
        <button
          type="button"
          class="w-btn hd-icon"
          aria-haspopup="true"
          aria-expanded="false"
          data-label={t(lang, 'site.theme')}
          data-names={JSON.stringify(Object.fromEntries(themes.map((id) => [id, t(lang, 'site.' + id)])))}
          aria-label={t(lang, 'site.theme', { name: t(lang, 'site.auto') })}
        >
          <svg data-icon="auto" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path></svg>
          <svg data-icon="light" style="display: none" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg data-icon="dark" style="display: none" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
        </button>
        <div role="group" aria-label={t(lang, 'site.themeGroup')} class="hd-pop hd-pop-wide" hidden>
          {
            themes.map((id) => (
              <button type="button" class="w-btn hd-choice" data-theme-choice={id} aria-pressed="false">
                <span>{t(lang, 'site.' + id)}</span>
                <span aria-hidden="true" class="hd-mark"></span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { applyTheme, savedTheme, type Theme } from '../lib/theme';

  const menus = [...document.querySelectorAll<HTMLElement>('[data-menu]')];
  const close = (except?: HTMLElement) => {
    for (const m of menus) {
      if (m === except) continue;
      m.querySelector('[role=group]')!.toggleAttribute('hidden', true);
      m.querySelector('button')!.setAttribute('aria-expanded', 'false');
    }
  };
  for (const m of menus) {
    const button = m.querySelector('button')!;
    const pop = m.querySelector<HTMLElement>('[role=group]')!;
    button.addEventListener('click', () => {
      const open = pop.hidden;
      close(m);
      pop.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    });
  }
  document.addEventListener('click', (e) => {
    if (!menus.some((m) => m.contains(e.target as Node))) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  const themeMenu = document.querySelector<HTMLElement>('[data-theme-menu]')!;
  const themeButton = themeMenu.querySelector('button')!;
  const names = JSON.parse(themeButton.dataset.names!) as Record<Theme, string>;
  const show = (theme: Theme) => {
    themeButton.setAttribute('aria-label', themeButton.dataset.label!.replace('{name}', names[theme]));
    for (const icon of themeButton.querySelectorAll<SVGElement>('[data-icon]')) {
      icon.style.display = icon.dataset.icon === theme ? '' : 'none';
    }
    for (const b of themeMenu.querySelectorAll<HTMLElement>('[data-theme-choice]')) {
      const on = b.dataset.themeChoice === theme;
      b.setAttribute('aria-pressed', String(on));
      b.querySelector('.hd-mark')!.textContent = on ? '✓' : '';
    }
  };
  for (const b of themeMenu.querySelectorAll<HTMLElement>('[data-theme-choice]')) {
    b.addEventListener('click', () => {
      const theme = b.dataset.themeChoice as Theme;
      applyTheme(theme);
      show(theme);
      close();
    });
  }
  show(savedTheme());
</script>

