---
// The mark a link out of the site carries after its text: an arrow leaving a box, and words for screen readers.
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<svg class="w-ext-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"></path><path d="M20 4l-9 9"></path><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path></svg><span class="w-sr"> ({t(lang, 'site.newWindow')})</span>
